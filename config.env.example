# Copy this file to config.env and edit values for your local run.

# Resource settings
THREADS=4
SORT_MEM=1G

# Input and reference paths
REFERENCE=00_reference/genome.fna
BWA_INDEX=00_reference/index/genome
FASTQ_DIR=01_raw_data

# snpEff settings
SNPEFF_DATA_DIR=07_annotation
CG_DB_NAME=Corynebacterium_glutamicum_ATCC13032
# SNPEFF_CONFIG=/path/to/snpEff.config

# Variant filtering thresholds
MIN_DP_CALL=10
MIN_DP_AF=20
MIN_AF_POLY=0.01
MAX_AF_POLY=0.99
MIN_AF_HIGH=0.80
MIN_QUAL=30
